# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_procurement
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_pass
DATABASE_URL=postgresql://erp_user:erp_pass@localhost:5432/erp_procurement

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_CONTRACTS=vendor_contracts
CHROMA_COLLECTION_POLICIES=procurement_policies

# ── AWS / Bedrock ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
BEDROCK_MODEL_ID=anthropic.claude-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── S3 (for PDFs — used when deploying to AWS) ────────────────────────────────
S3_BUCKET_NAME=erp-procurement-docs
S3_PREFIX_CONTRACTS=contracts/
S3_PREFIX_POLICIES=policies/

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Embedding model (local, no cost) ──────────────────────────────────────────
# Used locally; swap to Bedrock Titan in production
EMBED_MODEL=all-MiniLM-L6-v2
