# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_procurement
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_pass
DATABASE_URL=postgresql://erp_user:erp_pass@localhost:5432/erp_procurement

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_CONTRACTS=vendor_contracts
CHROMA_COLLECTION_POLICIES=procurement_policies

# ── AWS / Bedrock ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── S3 (for PDFs — used when deploying to AWS) ────────────────────────────────
S3_BUCKET_NAME=erp-procurement-docs
S3_PREFIX_CONTRACTS=contracts/
S3_PREFIX_POLICIES=policies/

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Embedding model (local, no cost) ──────────────────────────────────────────
# Used locally; swap to Bedrock Titan in production
EMBED_MODEL=all-MiniLM-L6-v2

# ── GROQ_API to test locally ──────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Gateway (retry + fallback) ────────────────────────────────────────────
# Retry attempts on the primary model before falling back (transient errors only)
LLM_GATEWAY_MAX_RETRIES=2

# Fallback model used only if the primary is still failing after retries.
# Defaults shown below are used automatically if these are left unset.
GROQ_FALLBACK_MODEL_ID=openai/gpt-oss-120b
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Optional: separate Groq key for the fallback client. Useful if your primary
# key hits an account-level rate limit rather than a per-model one — otherwise
# falls back to GROQ_API_KEY.
GROQ_FALLBACK_API_KEY=

# ── Observability ──────────────────────────────────────────────────────────────
# Native tracing (this repo's own tracer.py) is always on — no config needed.
# Recorded traces are viewable via GET /traces and GET /traces/{trace_id},
# and persisted to logs/traces.jsonl.
#
# Optional, complementary: LangSmith tracing. LangGraph auto-instruments
# itself for LangSmith purely from these env vars — no code changes. Useful
# if you want a hosted trace UI instead of/alongside the native one. Requires
# a LangSmith account + API key; leave unset to skip it entirely.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=erp-procurement-assistant